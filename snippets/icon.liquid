{%- comment -%} {% render 'icon', name: 'cart' %} {%- endcomment -%}
{%- case name -%}
  {%- when 'logo' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="15" fill="#12808f"/>
      <path d="M7 16c3.4-5.2 10.3-6 14-2.6l3.8-2.6-1.2 5.2 1.2 5.2-3.8-2.6C17.3 22 10.4 21.2 7 16z" fill="#fff"/>
      <circle cx="12.4" cy="14.8" r="1.2" fill="#12808f"/>
    </svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5" stroke-linecap="round"/>
    </svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.5" r="3.8"/><path d="M4.8 20c1.3-3.7 4-5.5 7.2-5.5s5.9 1.8 7.2 5.5" stroke-linecap="round"/>
    </svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
      <path d="M4 6h2.2l2 10.4h9.6L20 8.6H7" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9.5" cy="20" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="17" cy="20" r="1.3" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
    </svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
    </svg>
  {%- when 'grid' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/>
      <rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>
    </svg>
  {%- when 'rows' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/>
      <rect x="3" y="16" width="18" height="4" rx="1"/>
    </svg>
  {%- when 'fish' -%}
    <svg viewBox="0 0 40 28" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M2 14c6-8 20-9 27-4l8-5-3 9 3 9-8-5c-7 5-21 4-27-4z" opacity=".9"/>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 40 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <path d="M2 6h20v14H2zM22 11h7l5 5v4h-12z" stroke-linejoin="round"/>
      <circle cx="9" cy="22" r="2.6"/><circle cx="28" cy="22" r="2.6"/>
    </svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H16.7V4.6c-.3 0-1.3-.13-2.5-.13-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V14h2.7v8z"/>
    </svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.76-1.77C18.3 5.1 12 5.1 12 5.1s-6.3 0-7.84.43A2.5 2.5 0 0 0 2.4 7.3C2 8.8 2 12 2 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.76 1.77C5.7 18.9 12 18.9 12 18.9s6.3 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77C22 15.2 22 12 22 12zm-12 3.1V8.9l5.2 3.1z"/>
    </svg>
{%- endcase -%}
