{%- comment -%}
  catalogue-notice.liquid — shown to visitors who cannot see pricing.
  {% render 'catalogue-notice' %}                  full-width band
  {% render 'catalogue-notice', context: 'product' %}  inline, inside the buy column
{%- endcomment -%}
{%- liquid
  assign b2b_url = settings.b2b_page.url | default: '/pages/b2b-application'
  assign contact_url = settings.contact_page.url | default: '/pages/contact'
-%}
<div class="gfa-gate{% if context == 'product' %} gfa-gate--inline{% endif %}">
  <div class="gfa-gate__text">
    <strong>{{ settings.catalogue_heading | default: 'Trade pricing is hidden' }}</strong>
    <span>{{ settings.catalogue_note }}</span>
  </div>
  <div class="gfa-gate__actions">
    <a class="gfa-btn gfa-btn--primary gfa-btn--sm" href="{{ b2b_url }}">{{ 'customer.apply_b2b' | t }}</a>
    {%- if context == 'product' -%}
      <a class="gfa-btn gfa-btn--outline gfa-btn--sm" href="#enquire">{{ 'customer.contact_us' | t }}</a>
    {%- else -%}
      <a class="gfa-btn gfa-btn--outline gfa-btn--sm" href="{{ contact_url }}">{{ 'customer.contact_us' | t }}</a>
    {%- endif -%}
  </div>
</div>
