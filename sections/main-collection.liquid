{%- capture price_access %}{% render 'price-access' %}{% endcapture -%}
{%- liquid
  assign desc_plain = collection.description | strip_html | strip
  assign excerpt = desc_plain | truncatewords: section.settings.excerpt_words
  assign has_more = false
  if excerpt.size < desc_plain.size
    assign has_more = true
  endif

  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: current_sort
-%}
{%- paginate collection.products by section.settings.per_page -%}

<section class="gfa-colhero{% if collection.image and section.settings.show_banner %} gfa-colhero--image{% endif %}">
  {%- if collection.image and section.settings.show_banner -%}
    <div class="gfa-colhero__media">
      {{ collection.image | image_url: width: 2000 | image_tag:
         widths: '600,900,1400,2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    </div>
    <div class="gfa-colhero__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="gfa-shell gfa-colhero__in">
    <nav class="gfa-breadcrumb gfa-colhero__crumbs" aria-label="{{ 'general.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> /
      <span>{{ collection.title }}</span>
    </nav>
    <h1>{{ collection.title }}</h1>
    {%- if desc_plain != blank -%}
      <p class="gfa-colhero__intro">
        {{ excerpt }}
        {%- if has_more %} <a href="#collection-about">{{ 'collections.read_more' | t }}</a>{% endif -%}
      </p>
    {%- endif -%}
    <p class="gfa-colhero__meta">
      <span class="gfa-num">{{ collection.products_count }}</span> {{ 'collections.products' | t }}
    </p>
  </div>
</section>

<div class="gfa-shell">
  <div class="gfa-collection">
    <aside class="gfa-filters" id="gfa-filters" data-filters>
      <div class="gfa-filters__head">
        <h2>{{ 'collections.filters' | t }}</h2>
        {%- if active_count > 0 -%}
          <a class="gfa-filters__clear" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
        {%- endif -%}
        <button class="gfa-iconbtn gfa-filters__close" type="button" data-filters-toggle aria-controls="gfa-filters" aria-label="{{ 'general.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <form id="gfa-filter-form">
        {%- if collection.filters.size > 0 -%}
          {%- for filter in collection.filters -%}
            {%- comment -%} A price filter would hint at wholesale rates, so only approved customers get it. {%- endcomment -%}
            {%- if filter.type == 'price_range' and price_access contains 'false' -%}{%- continue -%}{%- endif -%}

            {%- liquid
              assign group_open = true
              if forloop.index > section.settings.open_groups and filter.active_values.size == 0
                assign group_open = false
              endif
            -%}
            <details class="gfa-filters__group"{% if group_open %} open{% endif %}>
              <summary>
                {{ filter.label }}
                {%- if filter.active_values.size > 0 -%}<span class="gfa-filters__badge gfa-num">{{ filter.active_values.size }}</span>{%- endif -%}
              </summary>
              <div class="gfa-filters__body">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- for value in filter.values -%}
                      <label class="gfa-check{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                               {% if value.active %}checked{% endif %}
                               {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label }}</span>
                        <span>{{ value.count }}</span>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="gfa-filters__price">
                      <label class="visually-hidden" for="gfa-price-min">{{ 'collections.min' | t }}</label>
                      <input class="gfa-field" id="gfa-price-min" type="number" inputmode="decimal" name="{{ filter.min_value.param_name }}"
                             value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                             placeholder="{{ 'collections.min' | t }}" min="0">
                      <span aria-hidden="true">–</span>
                      <label class="visually-hidden" for="gfa-price-max">{{ 'collections.max' | t }}</label>
                      <input class="gfa-field" id="gfa-price-max" type="number" inputmode="decimal" name="{{ filter.max_value.param_name }}"
                             value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                             placeholder="{{ 'collections.max' | t }}" min="0">
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          <input type="hidden" name="sort_by" value="{{ current_sort }}" data-sort-mirror>
          <noscript><button class="gfa-btn gfa-btn--outline gfa-btn--sm gfa-btn--block" type="submit">{{ 'collections.apply' | t }}</button></noscript>
        {%- else -%}
          <p class="gfa-note">{{ 'collections.no_filters' | t }}</p>
        {%- endif -%}
      </form>

      <button class="gfa-btn gfa-btn--primary gfa-btn--block gfa-filters__done" type="button" data-filters-toggle aria-controls="gfa-filters">
        {{ 'collections.show_results' | t: count: collection.products_count }}
      </button>
    </aside>

    <div class="gfa-collection__main" id="products">
      {%- unless price_access contains 'true' -%}
        {% render 'catalogue-notice' %}
      {%- endunless -%}

      <div class="gfa-toolbar">
        <button class="gfa-btn gfa-btn--outline gfa-btn--sm gfa-toolbar__filters" type="button"
                data-filters-toggle aria-controls="gfa-filters" aria-expanded="false">
          {% render 'icon', name: 'filter' %}
          {{ 'collections.filters' | t }}
          {%- if active_count > 0 -%}<span class="gfa-filters__badge gfa-num">{{ active_count }}</span>{%- endif -%}
        </button>

        <span class="gfa-toolbar__count">
          <b>{{ collection.products_count }}</b> {{ 'collections.products' | t }}
        </span>

        <div class="gfa-toolbar__right">
          <label class="gfa-toolbar__sortlabel" for="gfa-sort">{{ 'collections.sort_by' | t }}</label>
          <select id="gfa-sort" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>

          <div class="gfa-viewtoggle" data-view-toggle>
            <button type="button" class="gfa-iconbtn is-active" data-view="grid" aria-label="{{ 'collections.view_grid' | t }}" aria-pressed="true">
              {% render 'icon', name: 'grid' %}
            </button>
            <button type="button" class="gfa-iconbtn" data-view="list" aria-label="{{ 'collections.view_list' | t }}" aria-pressed="false">
              {% render 'icon', name: 'rows' %}
            </button>
          </div>
        </div>
      </div>

      {%- if active_count > 0 -%}
        <ul class="gfa-chips" role="list">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <li>
                  <a class="gfa-chip" href="{{ filter.url_to_remove }}" aria-label="{{ 'collections.remove_filter' | t: label: filter.label }}">
                    {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }}–{% if filter.max_value.value %}{{ filter.max_value.value | money_without_trailing_zeros }}{% else %}{{ filter.range_max | money_without_trailing_zeros }}{% endif %}
                    {% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <li>
                  <a class="gfa-chip" href="{{ value.url_to_remove }}" aria-label="{{ 'collections.remove_filter' | t: label: value.label }}">
                    {{ value.label }} {% render 'icon', name: 'close' %}
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a class="gfa-chips__clear" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a></li>
        </ul>
      {%- endif -%}

      <div class="gfa-grid" data-product-grid>
        {%- for product in collection.products -%}
          {% render 'fish-card', product: product, lazy: forloop.index0 %}
        {%- else -%}
          <div class="gfa-collection__empty">
            <p class="gfa-lede">{{ 'collections.empty' | t }}</p>
            {%- if active_count > 0 -%}
              <a class="gfa-btn gfa-btn--outline" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate, anchor: '#products' %}
    </div>
  </div>
</div>

{%- if collection.description != blank and section.settings.show_about -%}
  <section class="gfa-colabout" id="collection-about">
    <div class="gfa-shell gfa-colabout__in">
      <h2>{{ 'collections.about' | t: title: collection.title }}</h2>
      <div class="gfa-prose">{{ collection.description }}</div>
    </div>
  </section>
{%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Stock list",
  "settings": [
    { "type": "range", "id": "per_page", "min": 12, "max": 48, "step": 12, "label": "Products per page", "default": 24 },
    { "type": "checkbox", "id": "show_banner", "label": "Show the collection image behind the title", "default": true },
    { "type": "range", "id": "excerpt_words", "min": 10, "max": 60, "step": 5, "label": "Intro length (words)", "default": 30, "info": "A short intro sits under the title so products show straight away." },
    { "type": "checkbox", "id": "show_about", "label": "Show the full description below the products", "default": true, "info": "Keeps the full text on the page for search engines." },
    { "type": "range", "id": "open_groups", "min": 1, "max": 6, "step": 1, "label": "Filter groups open by default", "default": 3 }
  ]
}
{% endschema %}
