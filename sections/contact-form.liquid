{%- comment -%}
  contact-form.liquid — general "Contact us" page. Submissions are emailed to the
  store's sender address; guests are prompted to apply for B2B pricing afterwards.
{%- endcomment -%}
{%- liquid
  assign form_id = 'Contact-' | append: section.id
  assign b2b_url = settings.b2b_page.url | default: '/pages/b2b-application'
  assign b2b_full = request.origin | append: b2b_url
  capture price_access
    render 'price-access'
  endcapture
  assign phone = section.settings.phone | default: settings.business_phone
  assign email = section.settings.email | default: settings.business_email
  assign hours = section.settings.hours | default: settings.business_hours
-%}
<section class="gfa-band">
  <div class="gfa-shell gfa-apply">
    <header class="gfa-apply__head">
      {%- if section.settings.eyebrow != blank -%}<p class="gfa-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<div class="gfa-lede">{{ section.settings.intro }}</div>{%- endif -%}

      <ul class="gfa-apply__contact">
        {%- if phone != blank -%}
          <li><span>Phone</span><a href="tel:{{ phone | remove: ' ' }}">{{ phone }}</a></li>
        {%- endif -%}
        {%- if email != blank -%}
          <li><span>Email</span><a href="mailto:{{ email }}">{{ email }}</a></li>
        {%- endif -%}
        {%- if hours != blank -%}
          <li><span>Hours</span><span class="gfa-apply__val">{{ hours }}{% if settings.business_hours_note != blank %}<small>{{ settings.business_hours_note }}</small>{% endif %}</span></li>
        {%- endif -%}
        {%- if settings.business_street != blank -%}
          <li><span>Visit</span><span class="gfa-apply__val">{{ settings.business_street }}<br>{{ settings.business_suburb }} {{ settings.business_state }} {{ settings.business_postcode }}</span></li>
        {%- endif -%}
      </ul>
    </header>

    <div class="gfa-panel gfa-apply__panel">
      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <div class="gfa-enquiry__done" role="status" tabindex="-1" data-enquiry-done>
            {% render 'icon', name: 'check' %}
            <div>
              <strong>{{ 'products.enquiry.success_heading' | t }}</strong>
              {%- if price_access contains 'true' -%}
                <p>{{ section.settings.success_text }}</p>
              {%- else -%}
                <p>{{ 'products.enquiry.success_body' | t }}</p>
                <a class="gfa-btn gfa-btn--primary gfa-btn--block" href="{{ b2b_url }}">{{ 'products.enquiry.register' | t }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="gfa-errors" role="alert">
              {{ 'customer.check_fields' | t }}
              <ul>{% for field in form.errors %}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{% endfor %}</ul>
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[Form]" value="Contact us">
          <input type="hidden" name="contact[B2B application link]" value="{{ b2b_full }}">

          <div class="gfa-form__grid">
            <div class="gfa-form__row">
              <label class="gfa-label" for="{{ form_id }}-name">{{ 'products.enquiry.name' | t }}</label>
              <input class="gfa-field" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" required data-enquiry-field="name">
            </div>
            <div class="gfa-form__row">
              <label class="gfa-label" for="{{ form_id }}-business">{{ 'products.enquiry.business' | t }}</label>
              <input class="gfa-field" id="{{ form_id }}-business" type="text" name="contact[Business name]" autocomplete="organization" data-enquiry-field="business">
            </div>
          </div>
          <div class="gfa-form__grid">
            <div class="gfa-form__row">
              <label class="gfa-label" for="{{ form_id }}-email">{{ 'customer.email' | t }}</label>
              <input class="gfa-field" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required data-enquiry-field="email">
            </div>
            <div class="gfa-form__row">
              <label class="gfa-label" for="{{ form_id }}-phone">{{ 'customer.phone' | t }}</label>
              <input class="gfa-field" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" data-enquiry-field="phone">
            </div>
          </div>
          <div class="gfa-form__row">
            <label class="gfa-label" for="{{ form_id }}-body">{{ 'products.enquiry.message' | t }}</label>
            <textarea class="gfa-field" id="{{ form_id }}-body" name="contact[body]" rows="5" required></textarea>
          </div>
          <button class="gfa-btn gfa-btn--primary gfa-btn--block" type="submit">{{ 'products.enquiry.submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Questions about stock, freight or a trade account? Send us a message and we will reply within one business day.</p>" },
    { "type": "paragraph", "content": "Phone, email, hours and address come from Theme settings → Business details. Fill these in only to override them here." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "hours", "label": "Hours" },
    { "type": "textarea", "id": "success_text", "label": "Success message (approved customers)", "default": "We will be in touch shortly." }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
