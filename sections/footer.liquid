<footer class="gfa-footer">
  <div class="gfa-shell gfa-footer__top">
    <div>
      <a class="gfa-logo" href="{{ routes.root_url }}" style="color:#fff">
        {% render 'icon', name: 'logo' %}
        <span style="color:#fff">Go<em style="color:#8fd8dd;font-style:normal">Fish</em>Aquariums</span>
      </a>
      <p class="gfa-footer__about" style="margin-top:16px">{{ section.settings.about }}</p>
      {%- if section.settings.abn != blank -%}
        <p class="gfa-footer__abn">{{ section.settings.abn }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'contact' -%}
          {%- comment -%} Details come from Theme settings → Business details. {%- endcomment -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <ul class="gfa-footer__contact">
              {%- if settings.business_hours != blank -%}
                <li>
                  {{ settings.business_hours }}
                  {%- if settings.business_hours_note != blank -%}<small>{{ settings.business_hours_note }}</small>{%- endif -%}
                </li>
              {%- endif -%}
              {%- if settings.business_street != blank -%}
                <li>
                  <a href="https://www.google.com/maps/search/?api=1&query={{ settings.business_street | append: ' ' | append: settings.business_suburb | append: ' ' | append: settings.business_state | append: ' ' | append: settings.business_postcode | url_encode }}" target="_blank" rel="noopener">
                    {{ settings.business_street }}<br>{{ settings.business_suburb }} {{ settings.business_state }} {{ settings.business_postcode }}
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.business_email != blank -%}
                <li><a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a></li>
              {%- endif -%}
              {%- if settings.business_phone != blank -%}
                <li><a href="tel:{{ settings.business_phone | remove: ' ' }}">{{ settings.business_phone }}</a></li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="gfa-shell gfa-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal }}</span>
    {%- for policy in shop.policies -%}
      {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
    {%- endfor -%}

    <div class="gfa-footer__social">
      {%- if settings.social_facebook != blank -%}
        <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
      {%- endif -%}
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
      {%- endif -%}
      {%- if settings.social_x != blank -%}
        <a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x-social' %}</a>
      {%- endif -%}
      {%- if settings.social_pinterest != blank -%}
        <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
      {%- endif -%}
      {%- if settings.social_youtube != blank -%}
        <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "paragraph", "content": "Contact details and social links are set in Theme settings → Business details." },
    { "type": "textarea", "id": "about", "label": "About text", "default": "Importer, quarantine and wholesaler of freshwater fish to independent pet and fish retail stores Australia wide. Trade only — we do not sell to the public." },
    { "type": "text", "id": "abn", "label": "ABN / licence line" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "Prices exclude GST." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact details" },
        { "type": "paragraph", "content": "Edit the details in Theme settings → Business details." }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
