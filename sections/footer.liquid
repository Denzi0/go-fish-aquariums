<footer class="gfa-footer">
  {%- if section.settings.statement != blank -%}
    <div class="gfa-shell gfa-footer__statement">
      <p class="gfa-footer__big">{{ section.settings.statement }}</p>
      {%- if section.settings.statement_label != blank -%}
        <a class="gfa-btn gfa-btn--primary" href="{{ section.settings.statement_link | default: settings.contact_page.url | default: '/pages/contact' }}">{{ section.settings.statement_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="gfa-shell gfa-footer__top">
    <div>
      <a class="gfa-logo gfa-footer__logo" href="{{ routes.root_url }}">
        <img src="{{ 'gfa-logo-footer.png' | asset_url }}" alt="{{ shop.name }}" width="480" height="407" loading="lazy">
      </a>
      <p class="gfa-footer__about" style="margin-top:16px">{{ section.settings.about }}</p>
      {%- if section.settings.abn != blank -%}
        <p class="gfa-footer__abn">{{ section.settings.abn }}</p>
      {%- endif -%}
      {%- liquid
        assign social_facebook = settings.social_facebook | default: 'https://www.facebook.com/people/Go-Fish-Aquariums/100064308211184/'
        assign social_instagram = settings.social_instagram | default: 'https://www.instagram.com/gofishaquariums'
        assign social_x = settings.social_x | default: 'https://x.com/GoFishAquariumX'
      -%}
      <div class="gfa-footer__follow">
        <h3>{{ section.settings.social_heading }}</h3>
        <ul class="gfa-footer__social">
          {%- if social_facebook != blank -%}
            <li><a href="{{ social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
          {%- if social_instagram != blank -%}
            <li><a href="{{ social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if social_x != blank -%}
            <li><a href="{{ social_x }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x-social' %}</a></li>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'contact' -%}
          {%- comment -%} Details come from Theme settings → Business details. {%- endcomment -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <ul class="gfa-footer__contact">
              {%- if settings.business_hours != blank -%}
                <li>
                  {% render 'icon', name: 'clock' %}
                  <span>{{ settings.business_hours }}
                  {%- if settings.business_hours_note != blank -%}<small>{{ settings.business_hours_note }}</small>{%- endif -%}</span>
                </li>
              {%- endif -%}
              {%- if settings.business_street != blank -%}
                <li>
                  {% render 'icon', name: 'pin' %}
                  <a href="https://www.google.com/maps/search/?api=1&query={{ settings.business_street | append: ' ' | append: settings.business_suburb | append: ' ' | append: settings.business_state | append: ' ' | append: settings.business_postcode | url_encode }}" target="_blank" rel="noopener">
                    {{ settings.business_street }}<br>{{ settings.business_suburb }} {{ settings.business_state }} {{ settings.business_postcode }}
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.business_email != blank -%}
                <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a></li>
              {%- endif -%}
              {%- if settings.business_phone != blank -%}
                <li>{% render 'icon', name: 'phone' %}<a href="tel:{{ settings.business_phone | remove: ' ' }}">{{ settings.business_phone }}</a></li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="gfa-shell gfa-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal }}</span>
    {%- for policy in shop.policies -%}
      {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
    {%- endfor -%}

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "paragraph", "content": "Contact details and social links are set in Theme settings → Business details." },
    { "type": "text", "id": "statement", "label": "Statement", "default": "Healthy fish for independent stores." },
    { "type": "text", "id": "statement_label", "label": "Statement button", "default": "Get in touch" },
    { "type": "url", "id": "statement_link", "label": "Statement button link", "info": "Defaults to the contact page." },
    { "type": "textarea", "id": "about", "label": "About text", "default": "Importer, quarantine and wholesaler of freshwater fish to independent pet and fish retail stores Australia wide. Trade only — we do not sell to the public." },
    { "type": "text", "id": "abn", "label": "ABN / licence line" },
    { "type": "text", "id": "social_heading", "label": "Social links heading", "default": "Follow us" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "Prices exclude GST." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact details" },
        { "type": "paragraph", "content": "Edit the details in Theme settings → Business details." }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
