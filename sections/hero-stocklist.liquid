{%- liquid
  assign snapshot = collections[section.settings.snapshot_collection]
  if section.settings.snapshot_collection == blank
    assign snapshot = collections.all
  endif

  assign layout = section.settings.layout
  assign has_custom_image = false
  if section.settings.image
    assign has_custom_image = true
  endif
-%}

{%- liquid
  assign has_strip = false
  if section.settings.show_snapshot and layout == 'photo'
    assign has_strip = true
  endif
-%}
<section class="gfa-hero gfa-hero--{{ layout }}{% unless has_strip %} gfa-hero--nostrip{% endunless %}">
  {%- if layout == 'photo' -%}
    <div class="gfa-hero__media" aria-hidden="true" style="--focal: {{ section.settings.focal_point }};">
      {%- if has_custom_image -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag:
           widths: '800,1200,1600,2000,2400',
           sizes: '100vw',
           loading: 'eager',
           fetchpriority: 'high',
           alt: '' }}
      {%- else -%}
        <picture>
          <source srcset="{{ 'hero-water.webp' | asset_url }}" type="image/webp">
          <img src="{{ 'hero-water.jpg' | asset_url }}" alt="" loading="eager" fetchpriority="high" width="1000" height="497">
        </picture>
      {%- endif -%}
    </div>
  {%- endif -%}

  <span class="gfa-hero__water" aria-hidden="true"
        style="--scrim: {{ section.settings.scrim | divided_by: 100.0 }};"></span>

  <div class="gfa-shell gfa-hero__in">
    <div class="gfa-hero__col">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gfa-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1>{{ section.settings.heading }}</h1>
      <p class="gfa-hero__copy">{{ section.settings.copy }}</p>

      <div class="gfa-hero__cta">
        {%- if section.settings.cta_label != blank -%}
          <a class="gfa-btn gfa-btn--primary" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="gfa-btn gfa-btn--onDark" href="{{ section.settings.cta2_url | default: routes.account_register_url }}">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="gfa-hero__proof">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_snapshot and layout == 'split' -%}
      {% render 'stock-snapshot',
         collection: snapshot,
         variant: 'panel',
         title: section.settings.snapshot_title,
         updated: section.settings.snapshot_updated,
         count: section.settings.snapshot_count,
         note: section.settings.snapshot_note,
         link_url: section.settings.snapshot_link,
         link_label: section.settings.snapshot_link_label %}
    {%- endif -%}
  </div>

  {%- if section.settings.show_snapshot and layout == 'photo' -%}
    <div class="gfa-shell gfa-hero__strip">
      {% render 'stock-snapshot',
         collection: snapshot,
         variant: 'strip',
         title: section.settings.snapshot_title,
         updated: section.settings.snapshot_updated,
         count: section.settings.snapshot_count,
         note: section.settings.snapshot_note,
         link_url: section.settings.snapshot_link,
         link_label: section.settings.snapshot_link_label %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero + stock snapshot",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "photo",
      "options": [
        { "value": "photo", "label": "Photo background, stock bar underneath" },
        { "value": "split", "label": "No photo, stock panel beside the copy" }
      ] },
    { "type": "image_picker", "id": "image", "label": "Background image",
      "info": "Used by the photo layout. Leave empty to use the image the theme ships with. Supply roughly 2400px wide, with the subject on the right — the left half is where the headline sits." },
    { "type": "select", "id": "focal_point", "label": "Keep this part of the image in frame", "default": "right center",
      "options": [
        { "value": "right center", "label": "Right" },
        { "value": "center", "label": "Centre" },
        { "value": "left center", "label": "Left" }
      ] },
    { "type": "range", "id": "scrim", "min": 40, "max": 100, "step": 5, "unit": "%", "label": "Darkening over the image", "default": 90,
      "info": "Raise this if your image is light and the headline is hard to read." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wholesale only · Australia wide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Freshwater livestock, graded and ready to ship" },
    { "type": "textarea", "id": "copy", "label": "Supporting copy", "default": "We supply aquarium retailers, pet chains and aquascaping studios with healthy freshwater fish and hard goods. Trade accounts see live stock counts, size grades and your own pricing." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "View fish" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Become a trade customer" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" },
    { "type": "header", "content": "Stock snapshot" },
    { "type": "checkbox", "id": "show_snapshot", "label": "Show snapshot", "default": true },
    { "type": "text", "id": "snapshot_title", "label": "Title", "default": "This week's list" },
    { "type": "text", "id": "snapshot_updated", "label": "Updated label", "default": "Updated daily" },
    { "type": "collection", "id": "snapshot_collection", "label": "Collection to show", "info": "Leave empty to show your most recent products." },
    { "type": "range", "id": "snapshot_count", "min": 3, "max": 8, "step": 1, "label": "Species shown", "default": 5 },
    { "type": "text", "id": "snapshot_note", "label": "Footer note", "default": "Counts update as orders are picked" },
    { "type": "text", "id": "snapshot_link_label", "label": "Footer link label", "default": "Full stock list" },
    { "type": "url", "id": "snapshot_link", "label": "Footer link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "220+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Species in stock" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero + stock snapshot",
      "blocks": [
        { "type": "stat", "settings": { "value": "220+", "label": "Species in stock" } },
        { "type": "stat", "settings": { "value": "Tue & Wed", "label": "Livestock dispatch" } },
        { "type": "stat", "settings": { "value": "98.6%", "label": "Live arrival, last 12 months" } }
      ]
    }
  ]
}
{% endschema %}
