{%- comment -%}
  stockists-teaser.liquid — short "find a stockist" band for the home page.
  The search box and state links open the full Stockists page with ?q= set,
  which the stockists section reads to pre-filter its list.
{%- endcomment -%}
{%- liquid
  assign stockists_url = section.settings.stockists_page.url | default: '/pages/stockists'
  assign states = section.settings.states | split: ','
-%}
<section class="gfa-band gfa-band--tight{% if section.settings.background == 'wash' %} gfa-band--wash{% endif %}">
  <div class="gfa-shell gfa-findstore">
    <div class="gfa-findstore__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="gfa-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.copy != blank -%}<p class="gfa-findstore__text">{{ section.settings.copy }}</p>{%- endif -%}

      <form class="gfa-findstore__search" action="{{ stockists_url }}" method="get" role="search">
        <label class="visually-hidden" for="FindStore-{{ section.id }}">{{ section.settings.placeholder }}</label>
        {% render 'icon', name: 'search' %}
        <input class="gfa-field" id="FindStore-{{ section.id }}" type="search" name="q"
               placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" enterkeyhint="search">
        <button class="gfa-btn gfa-btn--primary" type="submit">{{ section.settings.button_label }}</button>
      </form>

      {%- if states.size > 0 -%}
        <ul class="gfa-findstore__states" role="list">
          {%- for state in states -%}
            {%- assign code = state | strip -%}
            {%- if code != blank -%}
              <li><a class="gfa-topic" href="{{ stockists_url }}?q={{ code | url_encode }}">{{ code }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          <li><a class="gfa-link" href="{{ stockists_url }}">{{ section.settings.all_label }}</a></li>
        </ul>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="gfa-findstore__logos" role="list">
        {%- for block in section.blocks -%}
          {%- assign store_name = block.settings.name | escape -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" title="{{ store_name }}">{%- endif -%}
              <span class="gfa-findstore__logo{% if block.settings.logo_background == 'dark' %} gfa-findstore__logo--dark{% endif %}">
                {%- if block.settings.logo -%}
                  {{ block.settings.logo | image_url: width: 320 | image_tag: widths: '160,240,320', sizes: '140px', loading: 'lazy', alt: store_name }}
                {%- else -%}
                  <span class="gfa-findstore__name">{{ store_name }}</span>
                {%- endif -%}
              </span>
            {%- if block.settings.link != blank -%}<span class="visually-hidden"> (opens in a new tab)</span></a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Stockists (short)",
  "tag": "section",
  "settings": [
    { "type": "page", "id": "stockists_page", "label": "Stockists page", "info": "Falls back to /pages/stockists." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stockists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Go Fish near you" },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "Go Fish fish are sold through 37 independent aquarium and pet stores across Australia." },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Suburb, postcode or store name" },
    { "type": "text", "id": "button_label", "label": "Search button", "default": "Find a store" },
    { "type": "text", "id": "states", "label": "State links", "default": "NSW, VIC, QLD, SA, TAS", "info": "Comma separated." },
    { "type": "text", "id": "all_label", "label": "All stockists link", "default": "View all stockists" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Plain" },
        { "value": "wash", "label": "Light wash" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Store name", "default": "Store name" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "select",
          "id": "logo_background",
          "label": "Logo background",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark (for white logos)" }
          ],
          "default": "light"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Stockists (short)" } ]
}
{% endschema %}
