<section class="gfa-band gfa-band--dark">
  <div class="gfa-shell gfa-cta">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.copy }}</p>
      <div class="gfa-cta__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="gfa-btn gfa-btn--primary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="gfa-btn gfa-btn--onDark" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <ul class="gfa-checklist">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.value != blank -%}<b>{{ block.settings.value }}</b>{%- endif -%}
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open a trade account" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Pricing and stock counts are visible to approved trade customers only. Send through your ABN and we will usually have you set up within one business day." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Apply for an account" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Talk to a rep" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Requirement",
      "settings": [
        { "type": "text", "id": "value", "label": "Highlight", "default": "ABN" },
        { "type": "text", "id": "text", "label": "Text", "default": "Registered Australian business" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale CTA",
      "blocks": [
        { "type": "item", "settings": { "value": "ABN", "text": "Registered Australian business or NZ equivalent" } },
        { "type": "item", "settings": { "value": "$250", "text": "Minimum first order, ex GST" } },
        { "type": "item", "settings": { "value": "1 day", "text": "Typical account approval time" } },
        { "type": "item", "settings": { "value": "30 days", "text": "Payment terms available after three orders" } }
      ]
    }
  ]
}
{% endschema %}
