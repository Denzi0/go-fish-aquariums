<div class="gfa-shell gfa-band">
  <div class="gfa-panel">
    <h1 style="font-size:1.5rem">{{ shop.name }}</h1>
    <p class="gfa-note" style="margin:12px 0 20px">{{ 'general.password_note' | t }}</p>
    {%- form 'storefront_password' -%}
      <div class="gfa-form__row">
        <label class="gfa-label" for="gfa-pw">{{ 'general.password' | t }}</label>
        <input class="gfa-field" id="gfa-pw" type="password" name="password">
      </div>
      <button class="gfa-btn gfa-btn--primary gfa-btn--block" type="submit">{{ 'general.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
