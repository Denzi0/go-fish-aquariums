{%- comment -%}
  Shop by category. Two sources:
    "menu"   — reads a Shopify menu, so adding a collection to that menu adds a
               tile here. Counts and images come from the collections themselves.
    "blocks" — hand-picked tiles for full control of order and labels.
{%- endcomment -%}

<section class="gfa-band gfa-band--tight">
  <div class="gfa-shell">
    <div class="gfa-band-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="gfa-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="gfa-link" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="gfa-cats">
      {%- if section.settings.source == 'menu' and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links limit: section.settings.max_tiles -%}
          {%- liquid
            assign col = link.object
            assign img = col.image | default: col.products.first.featured_image
            if link.type == 'collection_link'
              assign meta = 'collections.count_species' | t: count: col.all_products_count
            else
              assign meta = 'collections.view_range' | t
            endif
          -%}
          {% render 'category-tile', url: link.url, title: link.title, meta: meta, image: img,
             shape: col.metafields.gofish.body_shape.value, tint: section.settings.silhouette_color, eager: false %}
        {%- endfor -%}

      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = collections[block.settings.collection]
            assign img = block.settings.image | default: col.image | default: col.products.first.featured_image
            if col != blank
              assign url = col.url
              assign meta = 'collections.count_species' | t: count: col.all_products_count
            else
              assign url = block.settings.fallback_url
              assign meta = block.settings.note
            endif
            assign title = block.settings.label | default: col.title
          -%}
          {% render 'category-tile', url: url, title: title, meta: meta, image: img,
             shape: block.settings.shape, tint: block.settings.color, attrs: block.shopify_attributes %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Livestock is grouped the way you order it — by type, then by size grade." },
    { "type": "select", "id": "source", "label": "Tiles come from", "default": "menu",
      "options": [
        { "value": "menu", "label": "A Shopify menu (updates itself)" },
        { "value": "blocks", "label": "Hand-picked tiles below" }
      ] },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu",
      "info": "Point this at a menu of collections — a 'Categories' menu works well. Tiles, counts and images follow whatever is in it. Each tile uses the collection image, falling back to the first product photo." },
    { "type": "range", "id": "max_tiles", "min": 3, "max": 12, "step": 1, "label": "Maximum tiles", "default": 8 },
    { "type": "color", "id": "silhouette_color", "label": "Silhouette colour", "default": "#12808f",
      "info": "Only shown for categories with no image yet. Upload a photo to the collection in Shopify and it replaces the silhouette." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All categories" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "text", "id": "note", "label": "Note (used when no collection is set)", "default": "View range" },
        { "type": "url", "id": "fallback_url", "label": "Fallback link" },
        { "type": "select", "id": "shape", "label": "Silhouette when there is no image", "default": "fusiform",
          "options": [
            { "value": "fusiform", "label": "Tetra / barb" },
            { "value": "cory", "label": "Corydoras" },
            { "value": "betta", "label": "Betta" },
            { "value": "koi", "label": "Goldfish / koi" },
            { "value": "angel", "label": "Angelfish" },
            { "value": "pleco", "label": "Pleco" }
          ] },
        { "type": "color", "id": "color", "label": "Silhouette colour", "default": "#12808f" }
      ]
    }
  ],
  "presets": [ { "name": "Shop by category" } ]
}
{% endschema %}
