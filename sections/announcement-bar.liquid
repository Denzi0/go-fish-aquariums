{%- if section.settings.enabled -%}
  <div class="gfa-notice">
    <div class="gfa-shell gfa-notice__in">
      {%- if section.settings.status_text != blank -%}
        <span class="gfa-notice__dot" aria-hidden="true"></span>
        <span>{{ section.settings.status_text }}</span>
      {%- endif -%}
      {%- if section.settings.secondary_text != blank -%}
        <span>{{ section.settings.secondary_text }}</span>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <span class="gfa-notice__spacer">
          {%- liquid
            assign notice_href = section.settings.link_url
            if notice_href == blank and settings.business_phone != blank
              assign notice_href = 'tel:' | append: settings.business_phone | remove: ' '
            endif
          -%}
          <a href="{{ notice_href }}">{{ section.settings.link_label }}</a>
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Dispatch bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show bar", "default": true },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status message",
      "info": "Update weekly. Buyers use this to time their order.",
      "default": "Open 7 days, 10am to 4pm — retail stores by appointment only"
    },
    { "type": "text", "id": "secondary_text", "label": "Secondary message", "default": "Wholesale to independent fish and pet stores Australia wide" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Trade enquiries +61 420 998 413" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Leave empty to call the phone number in Theme settings → Business details." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
