<section class="gfa-band{% if section.settings.background == 'wash' %} gfa-band--wash{% endif %}" id="image-text-{{ section.id }}">
  <div class="gfa-shell gfa-imgtext{% if section.settings.image_position == 'right' %} gfa-imgtext--right{% endif %}">
    <div class="gfa-imgtext__media gfa-imgtext__media--{{ section.settings.image_ratio }}">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag:
           widths: '600,900,1200,1600',
           sizes: '(max-width: 900px) 100vw, 50vw',
           loading: 'lazy',
           alt: section.settings.image.alt | default: section.settings.heading | escape }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'gfa-imgtext__placeholder' }}
      {%- endif -%}
    </div>

    <div class="gfa-imgtext__body">
      {%- if section.settings.eyebrow != blank -%}<p class="gfa-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.copy != blank -%}<div class="gfa-imgtext__copy">{{ section.settings.copy }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="gfa-btn gfa-btn--{{ section.settings.button_style }}" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "landscape"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Go Fish" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healthy fish, sourced with care" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>We work with reputable farms across Asia, many of them for decades, and condition every shipment before it leaves our facility for your local store.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The button is hidden until you set a link." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Teal" },
        { "value": "dark", "label": "Dark" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "wash", "label": "Light wash" }
      ],
      "default": "paper"
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
