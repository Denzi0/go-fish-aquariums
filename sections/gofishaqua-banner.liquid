{%- comment -%}
  GoFishAqua Banner section
  File: sections/gofishaqua-banner.liquid
  Online Store 2.0 section for campaigns, brand storytelling and collection highlights.
  Blocks: Subheading, Heading, Description, Button (add, remove, reorder and hide in the editor).
  All classes, IDs and custom properties use the "gofishaqua" prefix and are scoped per section instance.
{%- endcomment -%}

{%- liquid
  assign ss = section.settings
  assign gfa_root_id = 'gofishaqua-banner-' | append: section.id

  assign gfa_desktop_image = ss.desktop_image
  if gfa_desktop_image == blank
    assign gfa_desktop_image = ss.mobile_image
  endif
  assign gfa_mobile_image = ss.mobile_image
  if gfa_mobile_image == blank
    assign gfa_mobile_image = gfa_desktop_image
  endif

  if ss.desktop_image_position == 'focal'
    assign gfa_pos_d = gfa_desktop_image.presentation.focal_point | default: '50% 50%'
  else
    assign gfa_pos_d = ss.desktop_image_position
  endif

  if ss.mobile_image_position == 'focal'
    assign gfa_pos_m = gfa_mobile_image.presentation.focal_point | default: '50% 50%'
  else
    assign gfa_pos_m = ss.mobile_image_position
  endif

  if section.index == 1
    assign gfa_loading = 'eager'
    assign gfa_priority = 'high'
  else
    assign gfa_loading = 'lazy'
    assign gfa_priority = 'auto'
  endif

  if ss.layout_width == 'full'
    assign gfa_sizes = '100vw'
  else
    assign gfa_sizes = '(min-width: ' | append: ss.max_width | append: 'px) ' | append: ss.max_width | append: 'px, 100vw'
  endif

  case ss.text_align
    when 'left'
      assign gfa_justify_d = 'flex-start'
    when 'right'
      assign gfa_justify_d = 'flex-end'
    else
      assign gfa_justify_d = 'center'
  endcase

  case ss.mobile_text_align
    when 'left'
      assign gfa_align_m = 'left'
      assign gfa_justify_m = 'flex-start'
    when 'right'
      assign gfa_align_m = 'right'
      assign gfa_justify_m = 'flex-end'
    when 'center'
      assign gfa_align_m = 'center'
      assign gfa_justify_m = 'center'
    else
      assign gfa_align_m = ss.text_align
      assign gfa_justify_m = gfa_justify_d
  endcase

  case ss.vertical_align
    when 'top'
      assign gfa_valign = 'flex-start'
    when 'bottom'
      assign gfa_valign = 'flex-end'
    else
      assign gfa_valign = 'center'
  endcase

  assign gfa_overlay_opacity = ss.overlay_opacity | divided_by: 100.0
  assign gfa_box_alpha = ss.content_box_opacity | divided_by: 100.0
  assign gfa_box_bg = ss.content_box_color | color_modify: 'alpha', gfa_box_alpha
-%}

<div
  id="{{ gfa_root_id }}"
  class="gofishaqua-banner gofishaqua-banner--{{ ss.layout_width }} gofishaqua-banner--h-{{ ss.text_align }}{% if ss.text_shadow %} gofishaqua-banner--shadow{% endif %}{% if ss.show_content_box %} gofishaqua-banner--boxed{% endif %}"
  data-gofishaqua-section="banner"
  style="
    {%- if ss.section_background != blank -%}--gofishaqua-banner-section-bg: {{ ss.section_background }};{%- endif -%}
    --gofishaqua-banner-fallback-bg: {{ ss.fallback_background }};
    --gofishaqua-banner-height-d: {{ ss.height_desktop }}px;
    --gofishaqua-banner-height-m: {{ ss.height_mobile }}px;
    --gofishaqua-banner-max-width: {{ ss.max_width }}px;
    --gofishaqua-banner-radius: {{ ss.border_radius }}px;
    --gofishaqua-banner-btn-radius: {{ ss.button_radius }}px;
    --gofishaqua-banner-fit: {{ ss.image_fit }};
    --gofishaqua-banner-pos-d: {{ gfa_pos_d }};
    --gofishaqua-banner-pos-m: {{ gfa_pos_m }};
    --gofishaqua-banner-overlay: {{ ss.overlay_color }};
    --gofishaqua-banner-overlay-opacity: {{ gfa_overlay_opacity }};
    --gofishaqua-banner-justify-d: {{ gfa_justify_d }};
    --gofishaqua-banner-justify-m: {{ gfa_justify_m }};
    --gofishaqua-banner-align-d: {{ ss.text_align }};
    --gofishaqua-banner-align-m: {{ gfa_align_m }};
    --gofishaqua-banner-valign: {{ gfa_valign }};
    --gofishaqua-banner-content-width: {{ ss.content_width }}px;
    --gofishaqua-banner-pad-d: {{ ss.content_padding_desktop }}px;
    --gofishaqua-banner-pad-m: {{ ss.content_padding_mobile }}px;
    --gofishaqua-banner-box-bg: {{ gfa_box_bg }};
    --gofishaqua-banner-text: {{ ss.text_color }};
    --gofishaqua-banner-heading: {{ ss.heading_color }};
    --gofishaqua-banner-subheading: {{ ss.subheading_color }};
    --gofishaqua-banner-pt-d: {{ ss.padding_top_desktop }}px;
    --gofishaqua-banner-pb-d: {{ ss.padding_bottom_desktop }}px;
    --gofishaqua-banner-pt-m: {{ ss.padding_top_mobile }}px;
    --gofishaqua-banner-pb-m: {{ ss.padding_bottom_mobile }}px;
  "
>
  <div class="gofishaqua-banner__inner">
    <div class="gofishaqua-banner__media">
      {%- if gfa_desktop_image != blank -%}
        {%- assign gfa_alt = ss.image_alt | default: gfa_desktop_image.alt -%}
        <picture class="gofishaqua-banner__picture">
          {%- if ss.mobile_image != blank and ss.desktop_image != blank -%}
            {%- assign gfa_mobile_widths = '375,550,750,900,1100,1500' | split: ',' -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {%- for gfa_w in gfa_mobile_widths -%}
                  {%- assign gfa_w_num = gfa_w | plus: 0 -%}
                  {%- if ss.mobile_image.width > gfa_w_num -%}
                    {{ ss.mobile_image | image_url: width: gfa_w_num }} {{ gfa_w_num }}w,{{ ' ' }}
                  {%- endif -%}
                {%- endfor -%}
                {{ ss.mobile_image | image_url: width: ss.mobile_image.width }} {{ ss.mobile_image.width }}w
              "
              sizes="100vw"
              width="{{ ss.mobile_image.width }}"
              height="{{ ss.mobile_image.height }}"
            >
          {%- endif -%}
          {{
            gfa_desktop_image
            | image_url: width: 3840
            | image_tag:
              widths: '750, 1100, 1500, 1800, 2200, 2800, 3200, 3840',
              sizes: gfa_sizes,
              loading: gfa_loading,
              fetchpriority: gfa_priority,
              alt: gfa_alt,
              class: 'gofishaqua-banner__img'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'gofishaqua-banner__img gofishaqua-banner__placeholder' }}
      {%- endif -%}
    </div>

    {%- if ss.show_overlay -%}
      <div class="gofishaqua-banner__overlay gofishaqua-banner__overlay--{{ ss.overlay_style }}" aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gofishaqua-banner__content-wrap">
        <div class="gofishaqua-banner__content">
          {%- assign gfa_in_buttons = false -%}
          {%- for block in section.blocks -%}
            {%- assign bs = block.settings -%}
            {%- assign gfa_vis = 'gofishaqua-banner__item--show-' | append: bs.visibility -%}

            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- if bs.text != blank -%}
                  <p
                    class="gofishaqua-banner__subheading {{ gfa_vis }}"
                    style="--gofishaqua-banner-sub-size: {{ bs.text_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{- bs.text | escape -}}
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if bs.heading != blank -%}
                  <{{ bs.heading_tag }}
                    class="gofishaqua-banner__heading {{ gfa_vis }}"
                    style="--gofishaqua-banner-h-size-d: {{ bs.size_desktop }}px; --gofishaqua-banner-h-size-m: {{ bs.size_mobile }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{- bs.heading -}}
                  </{{ bs.heading_tag }}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if bs.text != blank -%}
                  <div
                    class="gofishaqua-banner__description {{ gfa_vis }}"
                    style="--gofishaqua-banner-body-size: {{ bs.text_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{- bs.text -}}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- unless gfa_in_buttons -%}
                  <div class="gofishaqua-banner__buttons">
                  {%- assign gfa_in_buttons = true -%}
                {%- endunless -%}

                {%- if bs.label != blank -%}
                  {%- capture gfa_btn_style -%}--gofishaqua-banner-btn-bg: {{ bs.button_color }}; --gofishaqua-banner-btn-text: {{ bs.button_text_color }};{%- endcapture -%}
                  {%- if bs.link != blank -%}
                    <a
                      href="{{ bs.link }}"
                      class="gofishaqua-banner__button gofishaqua-banner__button--{{ bs.style }} {{ gfa_vis }}"
                      style="{{ gfa_btn_style }}"
                      {{ block.shopify_attributes }}
                    >
                      {{- bs.label | escape -}}
                    </a>
                  {%- else -%}
                    <a
                      role="link"
                      aria-disabled="true"
                      class="gofishaqua-banner__button gofishaqua-banner__button--{{ bs.style }} gofishaqua-banner__button--disabled {{ gfa_vis }}"
                      style="{{ gfa_btn_style }}"
                      {{ block.shopify_attributes }}
                    >
                      {{- bs.label | escape -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}

                {%- assign gfa_next = section.blocks[forloop.index] -%}
                {%- if forloop.last or gfa_next.type != 'button' -%}
                  </div>
                  {%- assign gfa_in_buttons = false -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gofishaqua-banner {
    background: var(--gofishaqua-banner-section-bg, transparent);
    padding-top: var(--gofishaqua-banner-pt-m);
    padding-bottom: var(--gofishaqua-banner-pb-m);
  }

  .gofishaqua-banner *,
  .gofishaqua-banner *::before,
  .gofishaqua-banner *::after {
    box-sizing: border-box;
  }

  .gofishaqua-banner--contained {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .gofishaqua-banner__inner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    width: 100%;
    min-height: var(--gofishaqua-banner-height-m);
    margin: 0 auto;
    border-radius: var(--gofishaqua-banner-radius);
    background-color: var(--gofishaqua-banner-fallback-bg);
  }

  .gofishaqua-banner--contained .gofishaqua-banner__inner {
    max-width: var(--gofishaqua-banner-max-width);
  }

  /* Media */
  .gofishaqua-banner__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .gofishaqua-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gofishaqua-banner__img,
  .gofishaqua-banner__media svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: var(--gofishaqua-banner-fit, cover);
    object-position: var(--gofishaqua-banner-pos-m, 50% 50%);
  }

  .gofishaqua-banner__placeholder {
    background-color: var(--gofishaqua-banner-fallback-bg);
    fill: rgba(255, 255, 255, 0.16);
  }

  /* Overlay for text readability */
  .gofishaqua-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: var(--gofishaqua-banner-overlay-opacity);
    pointer-events: none;
  }

  .gofishaqua-banner__overlay--solid {
    background-color: var(--gofishaqua-banner-overlay);
  }

  .gofishaqua-banner__overlay--bottom,
  .gofishaqua-banner__overlay--side {
    background-image: linear-gradient(to top, var(--gofishaqua-banner-overlay) 0%, var(--gofishaqua-banner-overlay) 25%, transparent 90%);
  }

  /* Content */
  .gofishaqua-banner__content-wrap {
    position: relative;
    display: flex;
    width: 100%;
    justify-content: var(--gofishaqua-banner-justify-m);
    align-items: var(--gofishaqua-banner-valign);
    padding: var(--gofishaqua-banner-pad-m);
  }

  .gofishaqua-banner__content {
    width: 100%;
    max-width: var(--gofishaqua-banner-content-width);
    color: var(--gofishaqua-banner-text);
    text-align: var(--gofishaqua-banner-align-m);
    overflow-wrap: break-word;
  }

  .gofishaqua-banner--boxed .gofishaqua-banner__content {
    padding: 1.5rem;
    border-radius: max(calc(var(--gofishaqua-banner-radius) * 0.75), 4px);
    background-color: var(--gofishaqua-banner-box-bg);
  }

  .gofishaqua-banner__content > * {
    margin: 0;
  }

  .gofishaqua-banner__content > * + * {
    margin-top: 1rem;
  }

  .gofishaqua-banner__content > .gofishaqua-banner__subheading + * {
    margin-top: 0.625rem;
  }

  .gofishaqua-banner__content > .gofishaqua-banner__buttons:not(:first-child) {
    margin-top: 1.75rem;
  }

  .gofishaqua-banner__subheading {
    font-size: var(--gofishaqua-banner-sub-size, 16px);
    font-weight: 600;
    line-height: 1.4;
    color: var(--gofishaqua-banner-subheading);
  }

  .gofishaqua-banner__heading {
    font-family: var(--font-heading-family, inherit);
    font-weight: var(--font-heading-weight, 700);
    font-size: var(--gofishaqua-banner-h-size-m, 36px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--gofishaqua-banner-heading);
    text-wrap: balance;
  }

  .gofishaqua-banner__description {
    font-size: var(--gofishaqua-banner-body-size, 18px);
    line-height: 1.65;
  }

  .gofishaqua-banner__description > * {
    margin: 0 0 1em;
  }

  .gofishaqua-banner__description > *:last-child {
    margin-bottom: 0;
  }

  .gofishaqua-banner__description a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gofishaqua-banner--shadow .gofishaqua-banner__subheading,
  .gofishaqua-banner--shadow .gofishaqua-banner__heading,
  .gofishaqua-banner--shadow .gofishaqua-banner__description {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  /* Buttons */
  .gofishaqua-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: var(--gofishaqua-banner-justify-m);
  }

  .gofishaqua-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8125rem 1.75rem;
    border: 2px solid var(--gofishaqua-banner-btn-bg);
    border-radius: var(--gofishaqua-banner-btn-radius);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-shadow: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .gofishaqua-banner__button--solid {
    background-color: var(--gofishaqua-banner-btn-bg);
    color: var(--gofishaqua-banner-btn-text);
  }

  .gofishaqua-banner__button--outline {
    background-color: transparent;
    color: var(--gofishaqua-banner-btn-bg);
  }

  .gofishaqua-banner__button:focus-visible {
    outline: 2px solid var(--gofishaqua-banner-btn-bg);
    outline-offset: 3px;
  }

  .gofishaqua-banner__button--disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (hover: hover) {
    .gofishaqua-banner__button--solid:hover {
      background-color: transparent;
      color: var(--gofishaqua-banner-btn-bg);
    }

    .gofishaqua-banner__button--outline:hover {
      background-color: var(--gofishaqua-banner-btn-bg);
      color: var(--gofishaqua-banner-btn-text);
    }
  }

  /* Per-block visibility */
  @media screen and (max-width: 749px) {
    .gofishaqua-banner .gofishaqua-banner__item--show-desktop {
      display: none;
    }
  }

  /* Tablet and desktop */
  @media screen and (min-width: 750px) {
    .gofishaqua-banner .gofishaqua-banner__item--show-mobile {
      display: none;
    }

    .gofishaqua-banner {
      padding-top: var(--gofishaqua-banner-pt-d);
      padding-bottom: var(--gofishaqua-banner-pb-d);
    }

    .gofishaqua-banner--contained {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }

    .gofishaqua-banner__inner {
      min-height: var(--gofishaqua-banner-height-d);
    }

    .gofishaqua-banner__img,
    .gofishaqua-banner__media svg {
      object-position: var(--gofishaqua-banner-pos-d, 50% 50%);
    }

    .gofishaqua-banner__content-wrap {
      justify-content: var(--gofishaqua-banner-justify-d);
      padding: var(--gofishaqua-banner-pad-d);
    }

    .gofishaqua-banner__content {
      text-align: var(--gofishaqua-banner-align-d);
    }

    .gofishaqua-banner--boxed .gofishaqua-banner__content {
      padding: 2.5rem;
    }

    .gofishaqua-banner__buttons {
      justify-content: var(--gofishaqua-banner-justify-d);
    }

    .gofishaqua-banner__heading {
      font-size: var(--gofishaqua-banner-h-size-d, 60px);
    }

    .gofishaqua-banner--h-left .gofishaqua-banner__overlay--side {
      background-image: linear-gradient(to right, var(--gofishaqua-banner-overlay) 0%, var(--gofishaqua-banner-overlay) 20%, transparent 80%);
    }

    .gofishaqua-banner--h-right .gofishaqua-banner__overlay--side {
      background-image: linear-gradient(to left, var(--gofishaqua-banner-overlay) 0%, var(--gofishaqua-banner-overlay) 20%, transparent 80%);
    }

    .gofishaqua-banner--h-center .gofishaqua-banner__overlay--side {
      background-image: radial-gradient(ellipse at center, var(--gofishaqua-banner-overlay) 0%, var(--gofishaqua-banner-overlay) 30%, transparent 80%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gofishaqua-banner *,
    .gofishaqua-banner *::before,
    .gofishaqua-banner *::after {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GoFishAqua Banner",
  "tag": "section",
  "class": "gofishaqua-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended: 2400 x 1000px or larger. Set a focal point in the editor to control cropping."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Shown below 750px wide. Recommended: 1100 x 1400px portrait."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for screen readers. Leave blank to use the alt text saved in Files."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image sizing",
      "options": [
        { "value": "cover", "label": "Fill banner (crop)" },
        { "value": "contain", "label": "Fit whole image" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "options": [
        { "value": "focal", "label": "Use image focal point" },
        { "value": "50% 50%", "label": "Centre" },
        { "value": "50% 0%", "label": "Top" },
        { "value": "50% 100%", "label": "Bottom" },
        { "value": "0% 50%", "label": "Left" },
        { "value": "100% 50%", "label": "Right" }
      ],
      "default": "focal"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        { "value": "focal", "label": "Use image focal point" },
        { "value": "50% 50%", "label": "Centre" },
        { "value": "50% 0%", "label": "Top" },
        { "value": "50% 100%", "label": "Bottom" },
        { "value": "0% 50%", "label": "Left" },
        { "value": "100% 50%", "label": "Right" }
      ],
      "default": "focal"
    },
    {
      "type": "color",
      "id": "fallback_background",
      "label": "Background behind image",
      "info": "Shows while the image loads, around fitted images, and when no image is set.",
      "default": "#12383D"
    },
    {
      "type": "header",
      "content": "Overlay and readability"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "bottom", "label": "Fade from bottom" },
        { "value": "side", "label": "Fade from text side" }
      ],
      "default": "side"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#0A2A2E"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "text_shadow",
      "label": "Add soft text shadow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_content_box",
      "label": "Place text on a background panel",
      "default": false
    },
    {
      "type": "color",
      "id": "content_box_color",
      "label": "Panel colour",
      "default": "#0A2A2E"
    },
