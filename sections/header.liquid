{%- capture price_access %}{% render 'price-access' %}{% endcapture -%}
{%- assign menu = section.settings.menu -%}

<header class="gfa-header" data-header>
  {%- comment -%} Row 1 (the announcement bar) is its own section. Row 2: brand, search, account. {%- endcomment -%}
  <div class="gfa-header__main">
    <div class="gfa-shell gfa-header__in">
      <a class="gfa-logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name, width: 120, loading: 'eager' }}
        {%- else -%}
          {% render 'icon', name: 'logo' %}
          <span>
            {{ shop.name }}
            {%- if section.settings.tagline != blank -%}<small>{{ section.settings.tagline }}</small>{%- endif -%}
          </span>
        {%- endif -%}
      </a>

      {%- if section.settings.show_search -%}
        <button type="button" class="gfa-header__search" data-search-open
                aria-haspopup="dialog" aria-controls="gfa-search">
          {% render 'icon', name: 'search' %}
          <span class="gfa-header__search-text">{{ 'general.search_placeholder' | t }}</span>
          <kbd aria-hidden="true">/</kbd>
        </button>
      {%- endif -%}

      <div class="gfa-header__tools">
        {%- if section.settings.show_search -%}
          <button type="button" class="gfa-iconbtn gfa-header__search-icon" data-search-open
                  aria-haspopup="dialog" aria-controls="gfa-search" aria-label="{{ 'general.search' | t }}">
            {% render 'icon', name: 'search' %}
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          <a class="gfa-iconbtn" href="{{ routes.account_url }}" aria-label="{{ 'customer.account' | t }}">
            {% render 'icon', name: 'account' %}
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart and price_access contains 'true' -%}
          <a class="gfa-iconbtn" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
            {% render 'icon', name: 'cart' %}
            <span class="gfa-count" data-cart-count>{{ cart.item_count }}</span>
          </a>
        {%- endif -%}

        {%- if customer -%}
          {%- if section.settings.quick_order_url != blank -%}
            <a class="gfa-btn gfa-btn--outline gfa-btn--sm" href="{{ section.settings.quick_order_url }}">
              {{ 'general.quick_order' | t }}
            </a>
          {%- endif -%}
          <a class="gfa-btn gfa-btn--dark gfa-btn--sm" href="{{ routes.account_url }}">
            {{ 'customer.my_account' | t }}
          </a>
        {%- else -%}
          <a class="gfa-btn gfa-btn--dark gfa-btn--sm" href="{{ routes.account_login_url }}">
            {{ section.settings.login_label }}
          </a>
        {%- endif -%}

        <button class="gfa-iconbtn gfa-burger" type="button" data-menu-toggle
                aria-expanded="false" aria-controls="gfa-mobile-nav" aria-label="{{ 'general.menu' | t }}">
          {% render 'icon', name: 'menu' %}
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Row 3: navigation. Items with children open a full-width mega menu. {%- endcomment -%}
  {%- if menu.links.size > 0 -%}
    <div class="gfa-header__navbar">
      <nav class="gfa-shell gfa-nav" aria-label="{{ 'general.primary_nav' | t }}" data-nav>
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="gfa-nav__item">
              <button type="button" class="gfa-nav__link gfa-nav__link--parent"
                      aria-expanded="false" data-menu-btn
                      {% if link.active or link.child_active %}data-active{% endif %}>
                {{ link.title }}
                <svg class="gfa-nav__chev" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>

              <div class="gfa-menu" hidden data-menu-panel>
                <div class="gfa-shell gfa-menu__in">
                  <div class="gfa-menu__cols">
                    {%- for child in link.links -%}
                      <div class="gfa-menu__col">
                        <a class="gfa-menu__head" href="{{ child.url }}">
                          {{ child.title }}
                          {%- if child.type == 'collection_link' and child.object.all_products_count > 0 -%}
                            <span class="gfa-menu__count">{{ child.object.all_products_count }}</span>
                          {%- endif -%}
                        </a>

                        {%- if child.links.size > 0 -%}
                          <ul>
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>

                  {%- if link.type == 'collection_link' -%}
                    <a class="gfa-menu__feature" href="{{ link.url }}">
                      {%- if section.settings.show_menu_images and link.object.image -%}
                        {{ link.object.image | image_url: width: 560 | image_tag:
                            widths: '280,420,560', sizes: '280px', loading: 'lazy', alt: link.object.title }}
                      {%- endif -%}
                      <span class="gfa-link">{{ 'general.view_all' | t: title: link.title }}</span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a class="gfa-nav__link" href="{{ link.url }}"
               {% if link.current %}aria-current="page"{% elsif link.active %}data-active{% endif %}>
              {{ link.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  {%- endif -%}

  <div class="gfa-mobilenav" id="gfa-mobile-nav" hidden>
    <div class="gfa-shell">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <details {% if link.active or link.child_active %}open{% endif %}>
            <summary>{{ link.title }}</summary>
            {%- for child in link.links -%}
              <a class="gfa-mobilenav__child" href="{{ child.url }}">{{ child.title }}</a>
              {%- for grandchild in child.links -%}
                <a class="gfa-mobilenav__child gfa-mobilenav__child--deep" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
              {%- endfor -%}
            {%- endfor -%}
          </details>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</header>

{%- if section.settings.show_search -%}
  <dialog class="gfa-search" id="gfa-search" aria-label="{{ 'general.search' | t }}" data-search-dialog>
    <form class="gfa-search__form" action="{{ routes.search_url }}" method="get" role="search">
      {% render 'icon', name: 'search' %}
      <input type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="{{ 'general.search_placeholder' | t }}"
             aria-label="{{ 'general.search' | t }}" autocomplete="off" data-search-input>
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="gfa-iconbtn" data-search-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </form>
    <div class="gfa-search__results" data-search-results aria-live="polite"
         data-url="{{ routes.predictive_search_url }}" data-empty="{{ 'general.search_no_results' | t }}"
         data-all="{{ 'general.search_view_all' | t }}"></div>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the store name as a wordmark." },
    { "type": "text", "id": "tagline", "label": "Tagline under wordmark", "default": "Freshwater livestock wholesale" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Shown in the bar under the header. Nested items open a mega menu; two levels of nesting are supported." },
    { "type": "checkbox", "id": "show_menu_images", "label": "Show collection image in mega menu", "default": true, "info": "When a top-level menu item links to a collection." },
    { "type": "text", "id": "login_label", "label": "Trade login label", "default": "Trade login" },
    { "type": "url", "id": "quick_order_url", "label": "Quick order link", "info": "Shown to signed-in customers only." },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
