<div class="gfa-shell gfa-band">
  <div class="gfa-panel">
    <h1 style="font-size:1.4rem">{{ 'customer.reset_password' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      <div class="gfa-form__row">
        <label class="gfa-label" for="rp1">{{ 'customer.password' | t }}</label>
        <input class="gfa-field" id="rp1" type="password" name="customer[password]" autocomplete="new-password">
      </div>
      <div class="gfa-form__row">
        <label class="gfa-label" for="rp2">{{ 'customer.confirm_password' | t }}</label>
        <input class="gfa-field" id="rp2" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button class="gfa-btn gfa-btn--primary gfa-btn--block" type="submit">{{ 'customer.reset_password' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
